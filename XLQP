local decodePackedData = (function()
return function(encoded, expectedLength)
    local alphabet = 'ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/'
    local values = {}
    for index = 1, #alphabet do values[string.byte(alphabet, index)] = index - 1 end
    encoded = encoded:gsub('%s', '')
    assert(#encoded % 4 == 0, 'Invalid bundled data length')
    local output = buffer.create(expectedLength)
    local position = 0
    for index = 1, #encoded, 4 do
        local a,b,c,d = string.byte(encoded, index, index + 3)
        local first,second = values[a],values[b]
        local third,fourth = c == 61 and 0 or values[c],d == 61 and 0 or values[d]
        assert(first and second and third and fourth, 'Invalid bundled data character')
        local word = first * 262144 + second * 4096 + third * 64 + fourth
        assert(position < expectedLength, 'Bundled data is too long')
        buffer.writeu8(output, position, math.floor(word / 65536))
        position += 1
        if c ~= 61 then
            buffer.writeu8(output, position, math.floor(word / 256) % 256)
            position += 1
        end
        if d ~= 61 then
            buffer.writeu8(output, position, word % 256)
            position += 1
        end
    end
    assert(position == expectedLength, 'Bundled data is incomplete')
    return output
end

end)()

