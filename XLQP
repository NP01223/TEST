local exportFunctionCatalog = (function()
return function(records, rootFunction, serializerSource)
    local byFunction, byPrototype, items = {}, {}, {}
    for _, record in ipairs(records) do
        local item = byPrototype[record.prototype]
        if not item then
            item = {id = #items + 1, names = {}, prototype = record.prototype}
            byPrototype[record.prototype] = item
            items[#items + 1] = item
        end
        byFunction[record.callback] = item
    end
    local named, nameSets = 0, {}
    local function addName(callback, name)
        local item = byFunction[callback]
        if not item then return end
        local seen = nameSets[item] or {}
        nameSets[item] = seen
        if seen[name] then return end
        seen[name] = true
        if #item.names == 0 then named += 1 end
        if #item.names < 12 then item.names[#item.names + 1] = name end
    end
    addName(rootFunction, 'XLQP.ApplicationMain')
    local rootEnvironment = getfenv(rootFunction)
    for name, value in next, rootEnvironment, nil do
        if type(name) == 'string' and type(value) == 'function' then addName(value, name) end
    end
    local visited, visitedCount = {}, 0
    local function inspect(container, path, depth)
        if type(container) ~= 'table' or visited[container] or depth > 6 or visitedCount >= 20000 then return end
        visited[container] = true
        visitedCount += 1
        for name, value in next, container, nil do
            if type(name) == 'string' or type(name) == 'number' then
                local member = path .. '.' .. tostring(name)
                if type(value) == 'function' then addName(value, member)
                elseif type(value) == 'table' then inspect(value, member, depth + 1) end
            end
        end
    end
    local env = getgenv()
    for _, name in {'Library','Options','Toggles','Buttons','Tabs'} do
